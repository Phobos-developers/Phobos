msgstr ""

msgid "API Convention"
msgstr ""

msgid ""
"All exported API functions return `HRESULT` to indicate success or "
"failure following COM convention:"
msgstr ""

msgid "HRESULT"
msgstr ""

msgid "Meaning"
msgstr ""

msgid "`S_OK`"
msgstr ""

msgid "Operation completed successfully."
msgstr ""

msgid "`S_FALSE`"
msgstr ""

msgid ""
"Operation completed but had nothing to do (e.g., no matching effects "
"found)."
msgstr ""

msgid "`E_POINTER`"
msgstr ""

msgid "A required pointer parameter was null."
msgstr ""

msgid "`E_INVALIDARG`"
msgstr ""

msgid "One or more arguments are invalid."
msgstr ""

msgid "`E_UNEXPECTED`"
msgstr ""

msgid "An unexpected internal error occurred (e.g., extension data not found)."
msgstr ""

msgid "`E_FAIL`"
msgstr ""

msgid "The operation failed."
msgstr ""

msgid ""
"Functions that produce output data take an additional output pointer "
"parameter that receives the result. Use `SUCCEEDED(hr)` / `FAILED(hr)` to"
" check the return value."
msgstr ""

msgid "API Version Tracking"
msgstr ""

msgid "Semantic Versioning Rules"
msgstr ""

msgid ""
"**Major (X)**: Increment for breaking changes (backward incompatible API "
"modifications). Example: Deleting an API, changing function parameters, "
"modifying data structures that break existing code. When bumped, reset "
"Minor and Patch to 0 (e.g., 1.2.3 → 2.0.0)."
msgstr ""

msgid ""
"**Minor (Y)**: Increment for backward-compatible new features. Example: "
"Adding a new API function, new parameters that don't break existing code."
" When bumped, reset Patch to 0 (e.g., 1.2.3 → 1.3.0)."
msgstr ""

msgid ""
"**Patch (Z)**: Increment for backward-compatible miscs (no API changes). "
"Example: Fixing crashes, correcting calculations, optimizing internals "
"without changing interface (e.g., 1.2.3 → 1.2.4)."
msgstr ""

